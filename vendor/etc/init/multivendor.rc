# MultiVendor init.rc script
# Support multiple firmware versions, mainly used to add support for all variants
# while running latest available firmware
# Credits to @salvogiangri for the initial version of this script
# credits to Fede2782

# SM-G998B (Europe)
on early-fs && property:ro.boot.em.model=SM-G998B && property:ro.boot.bootloader=G998BXXSJHZC2
    # TEE
    mount none /vendor/tee_998b /vendor/tee bind
	# FW
    mount none /vendor/firmware_998b /vendor/firmware bind
    # OVERLAY
    mount none /vendor/overlay_998b /vendor/overlay bind
	
# SM-G998N (Korean)
on early-fs && property:ro.boot.em.model=SM-G998N && property:ro.boot.bootloader=G998NKSSCHZA9
    # TEE
    mount none /vendor/tee_998n /vendor/tee bind
	# FW
    mount none /vendor/firmware_998n /vendor/firmware bind
    # OVERLAY
    mount none /vendor/overlay_998n /vendor/overlay bind

# SM-G998N (Korean)
on early-fs && property:ro.boot.em.model=SM-G998N && property:ro.boot.bootloader=G998NKSSAHYH5
    # TEE
    mount none /vendor/tee_n_august /vendor/tee bind
	# FW
    mount none /vendor/firmware_n_august /vendor/firmware bind
    # OVERLAY
    mount none /vendor/overlay_998n /vendor/overlay bind